{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proper.local/schemas/proper_v2/memory_lifecycle_v2_2.schema.json",
  "title": "PROPER v2.2 Memory Lifecycle State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_version",
    "memory_experience_id",
    "phase",
    "status",
    "trigger_status",
    "success_evidence_status",
    "planning_mode",
    "exposure_mode",
    "injection_weight",
    "application_attempt_count",
    "failed_attempt_count",
    "remaining_application_attempts",
    "transition_index",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "method_version": {
      "const": "proper_v2_2_development"
    },
    "memory_experience_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "pre_action",
        "post_failure"
      ]
    },
    "status": {
      "enum": [
        "active",
        "consumed",
        "failed",
        "stopped"
      ]
    },
    "trigger_status": {
      "enum": [
        "holds",
        "cleared",
        "unknown"
      ]
    },
    "success_evidence_status": {
      "enum": [
        "satisfied",
        "violated",
        "unknown"
      ]
    },
    "planning_mode": {
      "enum": [
        "memory_guided",
        "ordinary_task_planning",
        "stopped"
      ]
    },
    "exposure_mode": {
      "enum": [
        "full",
        "demoted",
        "removed"
      ]
    },
    "injection_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "application_attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "failed_attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "remaining_application_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "transition_index": {
      "type": "integer",
      "minimum": 0
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "planning_mode": {
            "const": "memory_guided"
          },
          "exposure_mode": {
            "const": "full"
          },
          "injection_weight": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "consumed"
          }
        }
      },
      "then": {
        "properties": {
          "planning_mode": {
            "const": "ordinary_task_planning"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "stopped"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "planning_mode": {
            "const": "stopped"
          },
          "exposure_mode": {
            "const": "removed"
          },
          "injection_weight": {
            "const": 0
          }
        }
      }
    }
  ]
}
