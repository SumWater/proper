{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "confirmatory_gate_v1_analysis.schema.json",
  "title": "Confirmatory Gate v1 independent analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_kind",
    "identities",
    "population",
    "primary_recomputed",
    "all_valid_targets_descriptive_pair",
    "condition_metrics_all_valid_targets",
    "condition_metrics_primary_population",
    "tool_strata_primary_population",
    "effect_concentration",
    "improvement_instance_ids",
    "model_output_parse_failure_count",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_kind": {"const": "confirmatory_gate_v1_independent_analysis"},
    "identities": {"type": "object"},
    "population": {"type": "object"},
    "primary_recomputed": {"type": "object"},
    "all_valid_targets_descriptive_pair": {"type": "object"},
    "condition_metrics_all_valid_targets": {"type": "object"},
    "condition_metrics_primary_population": {"type": "object"},
    "tool_strata_primary_population": {"type": "array", "minItems": 7, "maxItems": 7},
    "effect_concentration": {"type": "object"},
    "improvement_instance_ids": {"type": "array", "minItems": 10, "maxItems": 10},
    "model_output_parse_failure_count": {"const": 0},
    "interpretation": {"type": "object"}
  }
}
