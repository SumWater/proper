{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proper.local/schemas/proper_v2_3/tau3_execution_state_continuation_screen.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_kind",
    "config_sha256",
    "input_branch_screen_sha256",
    "checks",
    "passed",
    "summary",
    "pairs",
    "model_loaded",
    "model_outputs_read",
    "gpu_used",
    "development_model_protocol_design_authorized",
    "development_model_run_authorized",
    "confirmatory_run_authorized",
    "next_gate"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_kind": {"const": "proper_v2_3_tau3_execution_state_continuation_screen"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_branch_screen_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "boolean"}
    },
    "passed": {"type": "boolean"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_count",
        "effect_counts",
        "scripted_progress_completion_count",
        "new_heldout_target_capacity"
      ],
      "properties": {
        "pair_count": {"type": "integer", "minimum": 0},
        "effect_counts": {"type": "object"},
        "scripted_progress_completion_count": {"type": "integer", "minimum": 0},
        "new_heldout_target_capacity": {"const": 0}
      }
    },
    "pairs": {"type": "array", "items": {"type": "object"}},
    "model_loaded": {"const": false},
    "model_outputs_read": {"const": false},
    "gpu_used": {"const": false},
    "development_model_protocol_design_authorized": {"type": "boolean"},
    "development_model_run_authorized": {"const": false},
    "confirmatory_run_authorized": {"const": false},
    "next_gate": {
      "enum": [
        "freeze_tau3_continuation_development_protocol",
        "stop_and_preserve_negative_screen"
      ]
    }
  }
}
