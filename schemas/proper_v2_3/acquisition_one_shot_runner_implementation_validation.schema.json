{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://proper.local/schemas/proper_v2_3/acquisition_one_shot_runner_implementation_validation.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","run_kind","passed","checks","implementation_config_sha256","input_sha256","scoped_tests_run","runner_implemented","remote_command_authorized","model_loaded","model_outputs_read","task_executed","gpu_used","next_gate"],
