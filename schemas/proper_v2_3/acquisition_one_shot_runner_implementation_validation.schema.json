    "checks":{"type":"object","minProperties":1,"additionalProperties":{"type":"boolean"}},"implementation_config_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "input_sha256":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"scoped_tests_run":{"const":24},
    "runner_implemented":{"const":true},"remote_command_authorized":{"type":"boolean"},"model_loaded":{"const":false},"model_outputs_read":{"const":false},"task_executed":{"const":false},"gpu_used":{"const":false},
