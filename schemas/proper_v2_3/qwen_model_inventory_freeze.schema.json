    "model_outputs_read": {"const":false},
    "task_executed": {"const":false},
    "gpu_used": {"const":false},
    "acquisition_runtime_protocol_design_authorized": {"type":"boolean"},
    "acquisition_runtime_freeze_authorized": {"const":false},
    "real_branch_capture_authorized": {"const":false},
    "model_runner_authorized": {"const":false},
    "confirmatory_run_authorized": {"const":false},
    "next_gate": {"enum":["design_acquisition_runtime_protocol","stop_inventory_freeze"]}
  }
}
