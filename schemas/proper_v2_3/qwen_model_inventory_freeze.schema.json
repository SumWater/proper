{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proper.local/schemas/proper_v2_3/qwen_model_inventory_freeze.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","run_kind","checks","passed","remote_result_sha256","successful_manifest_sha256","successful_file_count","successful_total_bytes","preserved_preflight_failures","model_loaded","model_outputs_read","task_executed","gpu_used","acquisition_runtime_protocol_design_authorized","acquisition_runtime_freeze_authorized","real_branch_capture_authorized","model_runner_authorized","confirmatory_run_authorized","next_gate"],
