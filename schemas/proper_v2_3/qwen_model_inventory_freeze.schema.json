    "run_kind": {"const":"proper_v2_3_qwen_model_inventory_local_freeze"},
    "checks": {"type":"object","minProperties":1,"additionalProperties":{"type":"boolean"}},
    "passed": {"type":"boolean"},
    "remote_result_sha256": {"type":"object","minProperties":3,"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "successful_manifest_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "successful_file_count": {"type":"integer","minimum":1},
    "successful_total_bytes": {"type":"integer","minimum":1},
    "preserved_preflight_failures": {"const":2},
