{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proper.local/schemas/proper_v2_3/tau3_model_protocol_feasibility.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_kind", "config_sha256", "candidate_config_sha256",
    "source_revision", "checks", "audit_passed", "protocol_ready", "summary",
    "pairs", "method_inputs_include_evaluator_metadata", "task_executed",
    "model_loaded", "model_outputs_read", "gpu_used",
    "model_protocol_freeze_authorized", "model_runner_implementation_authorized",
    "development_model_run_authorized", "confirmatory_run_authorized",
    "disposition", "next_gate"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_kind": {"const": "proper_v2_3_tau3_model_protocol_feasibility_audit"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "audit_passed": {"type": "boolean"},
    "protocol_ready": {"type": "boolean"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_count", "source_action_mapping_count", "model_ready_count", "phase_counts", "model_ready_phase_counts", "model_ready_effect_counts", "new_heldout_target_capacity"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "source_action_mapping_count": {"type": "integer", "minimum": 0},
        "model_ready_count": {"type": "integer", "minimum": 0},
        "phase_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "model_ready_phase_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "model_ready_effect_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "new_heldout_target_capacity": {"const": 0}
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pair_id", "domain", "phase", "effect_class", "source_action_mapping_valid", "task_start_arguments_publicly_visible", "frozen_public_branch_artifact_present", "post_failure_branch_ready", "model_ready", "reason"],
        "properties": {
          "pair_id": {"type": "string"}, "domain": {"type": "string"},
          "phase": {"enum": ["pre_action", "post_failure"]},
          "effect_class": {"enum": ["read_only", "idempotent_state_setting", "non_idempotent_side_effect"]},
          "source_action_mapping_valid": {"type": "boolean"},
          "task_start_arguments_publicly_visible": {"type": "boolean"},
          "frozen_public_branch_artifact_present": {"type": "boolean"},
          "post_failure_branch_ready": {"type": "boolean"},
          "model_ready": {"type": "boolean"},
          "reason": {"type": "string"}
        }
      }
    },
    "method_inputs_include_evaluator_metadata": {"const": false},
    "task_executed": {"const": false}, "model_loaded": {"const": false},
    "model_outputs_read": {"const": false}, "gpu_used": {"const": false},
    "model_protocol_freeze_authorized": {"type": "boolean"},
    "model_runner_implementation_authorized": {"type": "boolean"},
    "development_model_run_authorized": {"const": false},
    "confirmatory_run_authorized": {"const": false},
    "disposition": {"enum": ["freeze_model_protocol", "stop_before_model_protocol"]},
    "next_gate": {"enum": ["freeze_tau3_development_model_protocol", "design_public_branch_capture_without_model_exposure"]}
  }
}
