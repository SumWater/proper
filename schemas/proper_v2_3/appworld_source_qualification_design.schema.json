{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proper.local/schemas/proper_v2_3/appworld_source_qualification_design.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_kind", "checks", "passed", "source_acquired", "inventory_performed", "task_instruction_read", "ground_truth_read", "candidate_count", "model_loaded", "gpu_used", "model_run_authorized", "confirmatory_run_authorized", "next_gate"],
  "properties": {
    "schema_version": {"const": 1},
    "run_kind": {"const": "proper_v2_3_appworld_source_qualification_design_validation"},
    "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "passed": {"type": "boolean"},
    "source_acquired": {"const": false},
    "inventory_performed": {"const": false},
    "task_instruction_read": {"const": false},
    "ground_truth_read": {"const": false},
    "candidate_count": {"type": "null"},
    "model_loaded": {"const": false},
    "gpu_used": {"const": false},
    "model_run_authorized": {"const": false},
    "confirmatory_run_authorized": {"const": false},
    "next_gate": {"const": "design_offline_encrypted_source_acquisition_and_static_inventory_protocol"}
  }
}
