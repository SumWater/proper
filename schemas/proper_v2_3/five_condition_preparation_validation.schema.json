{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proper.local/schemas/proper_v2_3/five_condition_preparation_validation.schema.json",
  "type": "object",
  "required": ["schema_version", "run_kind", "run_id", "passed", "preconditions", "prepared_manifest_path", "prepared_manifest_sha256", "manifest_schema_validation", "tests", "boundary", "next_gate"],
  "properties": {
    "schema_version": {"const": 2},
    "run_kind": {"const": "proper_v2_3_five_condition_preparation_validation_v2"},
    "run_id": {"type": "string", "minLength": 20},
    "passed": {"type": "boolean"},
    "preconditions": {
      "type": "object",
      "required": ["execution_role", "project_revision", "required_ancestor_present", "tracked_worktree_clean", "tau_revision", "cuda_visible_devices", "python_version", "prior_failed_preparation_path", "prior_failed_preparation_sha256"],
      "properties": {
        "execution_role": {"const": "proper_v2_3_five_condition_remote_cpu_validation"},
        "project_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "required_ancestor_present": {"const": true},
        "tracked_worktree_clean": {"const": true},
        "tau_revision": {"const": "fc0055dc4e0a316c3f83133267fbd6faaa770992"},
        "cuda_visible_devices": {"const": "-1"},
        "python_version": {"type": "string", "pattern": "^3\\.(11|12)\\."}
        ,"prior_failed_preparation_path": {"const": "outputs/proper_v2_3/five_condition_development/prepared_manifest.json"}
        ,"prior_failed_preparation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "prepared_manifest_path": {"type": "string", "pattern": "^outputs/proper_v2_3/five_condition_development_remote/[^/]+/prepared_manifest\\.json$"},
    "prepared_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_schema_validation": {
      "type": "object",
      "required": ["passed", "draft", "validator"],
      "properties": {
        "passed": {"type": "boolean"},
        "draft": {"const": "2020-12"},
        "validator": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "required": ["passed", "patterns", "expected_test_count", "tests_run", "test_count_matches_contract", "failures", "errors", "skipped", "runner_output"],
      "properties": {
        "passed": {"type": "boolean"},
        "patterns": {"const": ["test_proper_v2_3_*.py", "test_toolsandbox_v2_3_*.py"]},
        "expected_test_count": {"const": 72},
        "tests_run": {"type": "integer", "minimum": 0},
        "test_count_matches_contract": {"type": "boolean"},
        "failures": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "runner_output": {"type": "string"}
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["model_runner_implemented", "model_loaded", "gpu_used", "target_scenarios_played", "development_model_run_authorized", "confirmatory_claim_authorized", "new_heldout_target_capacity"],
      "properties": {
        "model_runner_implemented": {"const": false},
        "model_loaded": {"const": false},
        "gpu_used": {"const": false},
        "target_scenarios_played": {"const": false},
        "development_model_run_authorized": {"const": false},
        "confirmatory_claim_authorized": {"const": false},
        "new_heldout_target_capacity": {"const": 0}
      },
      "additionalProperties": false
    },
    "next_gate": {"enum": ["implement_and_freeze_separate_guarded_model_runner_before_gpu_authorization", "stop_and_preserve_preparation_failure"]}
  },
  "additionalProperties": false
}
