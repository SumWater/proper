{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proper.local/schemas/proper_v2_3/source_qualification.schema.json",
  "title": "PROPER v2.3 prospective source qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_kind",
    "passed",
    "checks",
    "repository",
    "domain_summaries",
    "static_continuation_opportunities",
    "static_continuation_opportunity_count",
    "capacity_checks",
    "prospective_partition",
    "source_qualified_for_cpu_branch_screening",
    "new_target_capacity_available",
    "native_recoverable_pair_count",
    "development_model_run_authorized",
    "confirmatory_run_authorized",
    "next_gate",
    "pending_exclusion_audits",
    "disposition",
    "boundary",
    "interpretation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_kind": {
      "const": "proper_v2_3_tau3_source_qualification"
    },
    "passed": {
      "type": "boolean"
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "tag",
        "revision",
        "selected_input_manifest_sha256",
        "selected_input_count"
      ],
      "properties": {
        "name": {
          "const": "tau3_bench"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/sha1"
        },
        "selected_input_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selected_input_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "domain_summaries": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "$ref": "#/$defs/domainSummary"
      }
    },
    "static_continuation_opportunities": {
      "$ref": "#/$defs/effectCounts"
    },
    "static_continuation_opportunity_count": {
      "type": "integer",
      "minimum": 0
    },
    "capacity_checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "prospective_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development_task_count",
        "heldout_task_count",
        "preservation_task_count",
        "manifest_sha256",
        "labels_are_prospective_not_qualified_targets"
      ],
      "properties": {
        "development_task_count": {
          "type": "integer",
          "minimum": 0
        },
        "heldout_task_count": {
          "type": "integer",
          "minimum": 0
        },
        "preservation_task_count": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "labels_are_prospective_not_qualified_targets": {
          "const": true
        }
      }
    },
    "source_qualified_for_cpu_branch_screening": {
      "type": "boolean"
    },
    "new_target_capacity_available": {
      "const": false
    },
    "native_recoverable_pair_count": {
      "const": 0
    },
    "development_model_run_authorized": {
      "const": false
    },
    "confirmatory_run_authorized": {
      "const": false
    },
    "next_gate": {
      "const": "cpu_scripted_recoverable_branch_validation"
    },
    "pending_exclusion_audits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "disposition": {
      "enum": [
        "continue_cpu_branch_screening",
        "stop_source_qualification"
      ]
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_loaded",
        "model_outputs_read",
        "bundled_historical_results_read",
        "target_tasks_executed",
        "gpu_used",
        "evaluator_actions_used_only_as_audit_depth_proxies",
        "audit_metadata_passed_to_method"
      ],
      "properties": {
        "model_loaded": {
          "const": false
        },
        "model_outputs_read": {
          "const": false
        },
        "bundled_historical_results_read": {
          "const": false
        },
        "target_tasks_executed": {
          "const": false
        },
        "gpu_used": {
          "const": false
        },
        "evaluator_actions_used_only_as_audit_depth_proxies": {
          "const": true
        },
        "audit_metadata_passed_to_method": {
          "const": false
        }
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effectCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "idempotent_state_setting",
        "non_idempotent_side_effect"
      ],
      "properties": {
        "read_only": {
          "type": "integer",
          "minimum": 0
        },
        "idempotent_state_setting": {
          "type": "integer",
          "minimum": 0
        },
        "non_idempotent_side_effect": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "domainSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_task_count",
        "eligible_base_task_count",
        "upstream_train_count",
        "upstream_test_count",
        "prospective_partition_counts",
        "static_continuation_opportunities",
        "uncovered_assistant_action_names"
      ],
      "properties": {
        "source_task_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_base_task_count": {
          "type": "integer",
          "minimum": 0
        },
        "upstream_train_count": {
          "type": "integer",
          "minimum": 0
        },
        "upstream_test_count": {
          "type": "integer",
          "minimum": 0
        },
        "prospective_partition_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "static_continuation_opportunities": {
          "$ref": "#/$defs/effectCounts"
        },
        "uncovered_assistant_action_names": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
