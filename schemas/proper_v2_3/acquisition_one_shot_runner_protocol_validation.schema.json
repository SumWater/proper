    "schema_version":{"const":1},"run_kind":{"const":"proper_v2_3_acquisition_one_shot_runner_protocol_validation"},"passed":{"type":"boolean"},
    "checks":{"type":"object","minProperties":1,"additionalProperties":{"type":"boolean"}},"protocol_config_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "input_sha256":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"scoped_tests_run":{"const":6},
    "runner_implemented":{"const":false},"model_loaded":{"const":false},"model_outputs_read":{"const":false},"task_executed":{"const":false},"gpu_used":{"const":false},
    "remote_command_authorized":{"const":false},"runner_implementation_authorized":{"type":"boolean"},
    "next_gate":{"enum":["implement_and_cpu_validate_one_shot_acquisition_runner","stop_protocol_design"]}
  }
}
