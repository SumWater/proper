{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proper.local/schemas/proper_v2_3/tau3_branch_replay_native_smoke.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_kind", "project_revision", "tau3_revision", "config_sha256", "checks", "passed", "selected_order_id_sha256", "native_execution_count", "checkpoint_sha256", "restored_checkpoint_sha256", "task_loaded", "model_loaded", "model_outputs_read", "gpu_used", "real_branch_capture_authorized", "model_runner_authorized", "model_run_authorized", "confirmatory_run_authorized", "next_gate"],
  "properties": {
    "schema_version": {"const": 1},
    "run_kind": {"const": "proper_v2_3_tau3_branch_replay_native_cpu_smoke"},
    "project_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tau3_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "passed": {"type": "boolean"},
    "selected_order_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "native_execution_count": {"type": "integer", "minimum": 0},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "restored_checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_loaded": {"const": false}, "model_loaded": {"const": false},
    "model_outputs_read": {"const": false}, "gpu_used": {"const": false},
    "real_branch_capture_authorized": {"type": "boolean"},
    "model_runner_authorized": {"const": false}, "model_run_authorized": {"const": false},
    "confirmatory_run_authorized": {"const": false},
    "next_gate": {"enum": ["freeze_public_branch_capture_protocol", "stop_native_replay_adapter"]}
  }
}
