            "extension_counts":{"type":"object","minProperties":1,"propertyNames":{"pattern":"^(<none>|\\.[a-z0-9]+)$"},"additionalProperties":{"type":"integer","minimum":1}},
            "hashed_members":{"type":"array","minItems":1,"maxItems":5000,"items":{"type":"object","additionalProperties":false,"required":["path_sha256","content_sha256","uncompressed_bytes","compressed_bytes"],"properties":{"path_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"uncompressed_bytes":{"type":"integer","minimum":0},"compressed_bytes":{"type":"integer","minimum":0}}}},
            "hashed_member_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
