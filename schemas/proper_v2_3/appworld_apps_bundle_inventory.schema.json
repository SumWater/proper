            "encrypted_sha256":{"const":"ba58bc5679c3573aa8f60ad6f5cda4377128a0ec569de5eef9543a77561796bb"},
            "decrypted_zip_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
