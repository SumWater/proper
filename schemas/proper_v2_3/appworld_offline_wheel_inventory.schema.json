{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proper.local/schemas/proper_v2_3/appworld_offline_wheel_inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_kind", "project_revision", "expected_project_revision", "config_sha256", "wheel_path", "checks", "passed", "stop_reason", "inventory", "wheel_extracted", "protected_bundle_opened", "appworld_imported", "task_or_api_data_read", "model_loaded", "gpu_used", "source_install_authorized", "next_gate"],
  "properties": {
    "schema_version": {"const": 1},
    "run_kind": {"const": "proper_v2_3_appworld_read_only_offline_wheel_inventory"},
    "project_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "expected_project_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wheel_path": {"type": "string", "minLength": 1},
    "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "passed": {"type": "boolean"},
    "stop_reason": {"type": ["string", "null"]},
    "inventory": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["wheel_filename", "wheel_size_bytes", "wheel_sha256", "distribution", "version", "member_count", "total_uncompressed_bytes", "bundle_count", "bundle_paths", "members", "member_manifest_sha256", "wheel_extracted", "protected_bundle_opened"],
          "properties": {
            "wheel_filename": {"const": "appworld-0.1.3.post1-py3-none-any.whl"},
            "wheel_size_bytes": {"const": 625317},
            "wheel_sha256": {"const": "db77f8003982502383a50fa2974983894bd1c54f64e2fd3f7e1540d5edd037eb"},
            "distribution": {"const": "appworld"},
            "version": {"const": "0.1.3.post1"},
            "member_count": {"type": "integer", "minimum": 1},
            "total_uncompressed_bytes": {"type": "integer", "minimum": 1},
            "bundle_count": {"type": "integer", "minimum": 1},
            "bundle_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\.bundle$"}},
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["relative_path", "compressed_bytes", "uncompressed_bytes", "sha256"],
                "properties": {
                  "relative_path": {"type": "string", "minLength": 1},
                  "compressed_bytes": {"type": "integer", "minimum": 0},
                  "uncompressed_bytes": {"type": "integer", "minimum": 0},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            },
            "member_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "wheel_extracted": {"const": false},
            "protected_bundle_opened": {"const": false}
          }
        }
      ]
    },
    "wheel_extracted": {"const": false},
    "protected_bundle_opened": {"const": false},
    "appworld_imported": {"const": false},
    "task_or_api_data_read": {"const": false},
    "model_loaded": {"const": false},
    "gpu_used": {"const": false},
    "source_install_authorized": {"const": false},
    "next_gate": {"enum": ["freeze_returned_wheel_inventory", "stop_wheel_inventory"]}
  }
}
